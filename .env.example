# Provider de autenticação. Mantenha legacy até os usuários/perfis e o restante
# do runtime terem sido migrados para Supabase Auth.
VELLORA_AUTH_PROVIDER=legacy

# Configuração pública do Supabase de produção. A publishable key (ou a anon
# key legada) pode aparecer no bundle do navegador; nunca coloque uma secret
# key neste arquivo ou em código client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos que ainda usam a nomenclatura anon:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Provisionamento manual do primeiro usuário Supabase. Use estas entradas
# somente no comando de provisionamento e nunca salve valores reais no Git.
# A chave administrativa server-side deve ser fornecida fora deste arquivo;
# ela nunca deve ser prefixada com NEXT_PUBLIC_ nem ir para o bundle.
SUPABASE_URL=
SUPABASE_PROVISION_EMAIL=
SUPABASE_PROVISION_NAME=
SUPABASE_PROVISION_PASSWORD=
SUPABASE_PROVISION_ROLE=
SUPABASE_PROVISION_PHONE=
SUPABASE_PROVISION_RESET_PASSWORD=false

# Usado somente pelo provider legacy para assinar o cookie de sessão. Troque
# por um valor aleatório longo antes de colocar o legacy em produção.
VELLORA_SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio-longo

# Use somente na primeira inicialização de um banco vazio. Remova depois que
# o administrador for criado. Não salve os valores reais neste arquivo.
VELLORA_BOOTSTRAP_ADMIN_EMAIL=
VELLORA_BOOTSTRAP_ADMIN_PASSWORD=
VELLORA_BOOTSTRAP_ADMIN_NAME=
VELLORA_BOOTSTRAP_ADMIN_PHONE=

# Recuperação excepcional do administrador. Defina os dois valores somente
# quando precisar escolher um novo e-mail e uma nova senha para a conta admin.
# Use senha com 12+ caracteres. A recuperação é reaplicada uma vez em cada
# publicação enquanto essas variáveis existirem; remova-as após recuperar o acesso.
VELLORA_ADMIN_RECOVERY_EMAIL=
VELLORA_ADMIN_RECOVERY_PASSWORD=

# Recuperação normal de senha por e-mail (administrador, família e cuidador).
# Com VELLORA_AUTH_PROVIDER=supabase, o fluxo usa Supabase Auth e estas
# variáveis de reset legacy não são consultadas.
RESEND_API_KEY=
VELLORA_EMAIL_FROM=Vellora Saúde <acesso@seudominio.com.br>
# Produção Vercel: https://vellorasaude.com.br
VELLORA_APP_URL=https://seu-site.exemplo

# Proteção dos formulários públicos. Configure as duas chaves para exigir o Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Em legacy, use true para tornar o desafio obrigatório; no provider Supabase
# a aplicação já exige as duas chaves e falha fechando sem elas.
VELLORA_TURNSTILE_REQUIRED=false

# Alertas operacionais opcionais via Resend somente para intercorrências.
# Novos leads e novas candidaturas profissionais têm como fontes oficiais os
# painéis /admin/leads e /admin/profissionais. Aceita mais de um e-mail separado
# por vírgula.
VELLORA_NOTIFICATION_EMAIL=

# Quando ativado, bloqueia os painéis e impede que o formulário grave dados.
VELLORA_SAFE_PREVIEW=false
