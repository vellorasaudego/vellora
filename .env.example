# Segredo usado para assinar o cookie de sessão (login). Troque por um valor
# aleatório longo antes de colocar em produção.
VELLORA_SESSION_SECRET=troque-este-valor-por-um-segredo-aleatorio-longo

# Use somente na primeira inicialização de um banco vazio. Remova depois que
# o administrador for criado. Não salve os valores reais neste arquivo.
VELLORA_BOOTSTRAP_ADMIN_EMAIL=
VELLORA_BOOTSTRAP_ADMIN_PASSWORD=
VELLORA_BOOTSTRAP_ADMIN_NAME=
VELLORA_BOOTSTRAP_ADMIN_PHONE=

# Recuperação excepcional do administrador. Defina os dois valores somente
# quando precisar escolher um novo e-mail e uma nova senha para a conta admin.
# Use senha com 12+ caracteres. A recuperação é reaplicada uma vez em cada
# publicação enquanto essas variáveis existirem; remova-as após recuperar o acesso.
VELLORA_ADMIN_RECOVERY_EMAIL=
VELLORA_ADMIN_RECOVERY_PASSWORD=

# Recuperação normal de senha por e-mail (administrador, família e cuidador).
RESEND_API_KEY=
VELLORA_EMAIL_FROM=Vellora Saúde <acesso@seudominio.com.br>
VELLORA_APP_URL=https://seu-site.exemplo

# Proteção dos formulários públicos. Configure as duas chaves para exigir o Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Alertas operacionais para novos contatos, candidaturas e intercorrências.
# Aceita mais de um e-mail separado por vírgula. Requer as variáveis do Resend acima.
VELLORA_NOTIFICATION_EMAIL=

# Quando ativado, bloqueia os painéis e impede que o formulário grave dados.
VELLORA_SAFE_PREVIEW=false
