# Referência para uma prévia segura local. Não representa um ambiente Supabase
# separado e não deve receber dados reais de pacientes.
VELLORA_AUTH_PROVIDER=legacy
VELLORA_SESSION_SECRET=gere-um-segredo-diferente-para-staging
VELLORA_SAFE_PREVIEW=true
VELLORA_APP_URL=https://staging.seu-dominio.exemplo

# Deixe vazio para manter o Turnstile desativado no primeiro smoke test.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Opcional: destinatários via Resend somente para intercorrências.
# Novos leads e novas candidaturas profissionais têm como fontes oficiais os
# painéis /admin/leads e /admin/profissionais. Use uma caixa de testes.
RESEND_API_KEY=
VELLORA_EMAIL_FROM=Vellora Saúde <staging@seudominio.com.br>
VELLORA_NOTIFICATION_EMAIL=
